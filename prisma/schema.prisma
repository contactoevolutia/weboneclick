generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model marca {
  id_marca Int     @id @default(autoincrement())
  nombre   String  @db.VarChar(255)
  slug     String  @unique @db.VarChar(255)
  logo     String? @db.VarChar(500)
  odoo_id  Int?    @unique
  activo   Boolean @default(true)

  productos producto[]
}

model etiqueta {
  id_etiqueta Int     @id @default(autoincrement())
  nombre      String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  odoo_id     Int?    @unique
  activo      Boolean @default(true)

  productos etiqueta_producto[]
}

model etiqueta_producto {
  id_etiqueta Int
  id_producto Int

  etiqueta etiqueta @relation(fields: [id_etiqueta], references: [id_etiqueta], onDelete: Cascade)
  producto producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@id([id_etiqueta, id_producto])
}

model familia {
  id_familia   Int     @id @default(autoincrement())
  nombre       String  @db.VarChar(255)
  slug         String  @unique @db.VarChar(255)
  titulo       String? @db.VarChar(255)
  descripcion  String? @db.Text
  imagen_hero  String? @db.VarChar(500)
  orden        Int     @default(0)
  id_categoria Int?
  activo       Boolean @default(true)

  categoria categoria? @relation(fields: [id_categoria], references: [id_categoria], onDelete: SetNull)
}

model grupo_producto {
  id_grupo    Int     @id @default(autoincrement())
  nombre      String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  descripcion String? @db.Text
  activo      Boolean @default(true)

  items grupo_producto_item[]
}

model grupo_producto_item {
  id_grupo    Int
  id_producto Int
  orden       Int @default(0)

  grupo    grupo_producto @relation(fields: [id_grupo], references: [id_grupo], onDelete: Cascade)
  producto producto       @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@id([id_grupo, id_producto])
}

model beneficio {
  id_beneficio    Int       @id @default(autoincrement())
  nombre          String    @db.VarChar(255)
  slug            String    @unique @db.VarChar(255)
  descripcion     String?   @db.Text
  cuotas          Int?
  imagen          String?   @db.VarChar(500)
  vigencia_desde  DateTime?
  vigencia_hasta  DateTime?
  activo          Boolean   @default(true)

  tarjetas beneficio_tarjeta[]
}

model tarjeta_adherida {
  id_tarjeta Int     @id @default(autoincrement())
  nombre     String  @db.VarChar(255)
  slug       String  @unique @db.VarChar(255)
  logo       String? @db.VarChar(500)
  banco      String? @db.VarChar(255)
  activo     Boolean @default(true)

  beneficios beneficio_tarjeta[]
}

model beneficio_tarjeta {
  id_beneficio Int
  id_tarjeta   Int

  beneficio beneficio        @relation(fields: [id_beneficio], references: [id_beneficio], onDelete: Cascade)
  tarjeta   tarjeta_adherida @relation(fields: [id_tarjeta], references: [id_tarjeta], onDelete: Cascade)

  @@id([id_beneficio, id_tarjeta])
}

model banner {
  id_banner       Int       @id @default(autoincrement())
  titulo          String    @db.VarChar(255)
  imagen_desktop  String    @db.VarChar(500)
  imagen_mobile   String?   @db.VarChar(500)
  link            String?   @db.VarChar(500)
  ubicacion       String    @db.VarChar(50)
  orden           Int       @default(0)
  vigencia_desde  DateTime
  vigencia_hasta  DateTime?
  activo          Boolean   @default(true)
  /// HTML del contenido (texto, botón, etc.) inyectado en la home
  html            String?   @db.Text
  /// Clases CSS extra del contenedor (ej. oc-promo-dark / oc-promo-light)
  clase_css       String?   @db.VarChar(100)
}

/// Constancias fiscales / bancarias descargables en /fiscal (editables desde admin)
model constancia_fiscal {
  id_constancia Int      @id @default(autoincrement())
  titulo        String   @db.VarChar(255)
  /// impositiva | bancaria | exclusion
  categoria     String   @db.VarChar(50)
  archivo       String?  @db.VarChar(500)
  url_externa   String?  @db.VarChar(500)
  orden         Int      @default(0)
  activo        Boolean  @default(true)
  fecha_alta    DateTime @default(now())
  fecha_modif   DateTime @updatedAt
}

/// Tabla de exclusiones de retenciones / percepciones en /fiscal
model exclusion_fiscal {
  id_exclusion    Int       @id @default(autoincrement())
  impuesto        String    @db.VarChar(500)
  vigencia_desde  DateTime  @db.Date
  vigencia_hasta  DateTime? @db.Date
  orden           Int       @default(0)
  activo          Boolean   @default(true)
  fecha_alta      DateTime  @default(now())
  fecha_modif     DateTime  @updatedAt
}

model tienda {
  id_tienda      Int      @id @default(autoincrement())
  nombre         String   @db.VarChar(255)
  slug           String   @unique @db.VarChar(255)
  /// Dirección completa (como en /contacto)
  direccion      String   @db.VarChar(500)
  /// Línea corta para listados / mapa
  direccion_corta String? @db.VarChar(255)
  localidad      String   @db.VarChar(100)
  provincia      String   @db.VarChar(100)
  codigo_postal  String?  @db.VarChar(20)
  email          String?  @db.VarChar(255)
  telefono       String?  @db.VarChar(50)
  horarios       String?  @db.Text
  latitud        Decimal? @db.Decimal(10, 7)
  longitud       Decimal? @db.Decimal(10, 7)
  imagen         String?  @db.VarChar(500)
  orden          Int      @default(0)
  activo         Boolean  @default(true)

  almacenes almacen[]
  ventas    venta[]
}

model lista_deseos {
  id_lista     Int      @id @default(autoincrement())
  id_cliente   Int      @unique
  fecha_creada DateTime @default(now())

  cliente cliente             @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade)
  items   lista_deseos_item[]
}

model lista_deseos_item {
  id_lista    Int
  id_producto Int
  fecha_alta  DateTime @default(now())

  lista    lista_deseos @relation(fields: [id_lista], references: [id_lista], onDelete: Cascade)
  producto producto     @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@id([id_lista, id_producto])
}

model producto {
  id_producto Int     @id @default(autoincrement())
  titulo      String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  descripcion String  @db.Text
  sku         String? @db.VarChar(100)
  odoo_id     Int?    @unique
  id_marca    Int?
  cuotas_max  Int?
  activo      Boolean @default(true)

  marca           marca?                    @relation(fields: [id_marca], references: [id_marca], onDelete: SetNull)
  stocks          stock[]
  archivos        archivo_producto[]
  categorias      categoria_producto[]
  precios         precio_producto[]
  caracteristicas producto_caracteristica[]
  venta_detalles  venta_detalle[]
  etiquetas       etiqueta_producto[]
  grupos          grupo_producto_item[]
  wishlist_items  lista_deseos_item[]
  promociones     promocion_producto[]
  regalos         regalo_producto[]
  secciones       seccion_producto[]
  relaciones      productos_relacionados[] @relation("relaciones_origen")
  relacionado_de  productos_relacionados[] @relation("relaciones_destino")
}

/// Cross-sell / accesorios desde Odoo (accessory_product_ids)
model productos_relacionados {
  id_producto             Int
  id_producto_relacionado Int
  /// Por ahora: "accesorio"
  tipo_relacion           String @db.VarChar(50)
  orden                   Int    @default(0)

  producto    producto @relation("relaciones_origen", fields: [id_producto], references: [id_producto], onDelete: Cascade)
  relacionado producto @relation("relaciones_destino", fields: [id_producto_relacionado], references: [id_producto], onDelete: Cascade)

  @@id([id_producto, id_producto_relacionado, tipo_relacion])
  @@index([id_producto, tipo_relacion])
  @@map("productos_relacionados")
}

/// Secciones de productos de la home (Destacados, Fiesta, Potenciá iPhone)
model seccion {
  id_seccion Int     @id @default(autoincrement())
  /// Slot fijo en home: destacados | fiesta | potencia
  clave      String  @unique @db.VarChar(50)
  nombre     String  @db.VarChar(255)
  activo     Boolean @default(true)
  orden      Int     @default(0)

  productos seccion_producto[]

  @@map("secciones")
}

model seccion_producto {
  id_seccion  Int
  id_producto Int
  /// Destacados: apple | jbl | accesorios. Otras secciones: ''
  pestana     String @default("") @db.VarChar(50)
  orden       Int    @default(0)

  seccion  seccion  @relation(fields: [id_seccion], references: [id_seccion], onDelete: Cascade)
  producto producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@id([id_seccion, id_producto, pestana])
  @@map("secciones_productos")
}

model almacen {
  id_almacen           Int     @id @default(autoincrement())
  descripcion          String  @db.VarChar(255)
  odoo_id              Int?    @unique
  id_tienda            Int?
  /// Almacén desde el que se despacha envío a domicilio (ej. WH/Stock, odoo_id 14)
  es_envio_domicilio   Boolean @default(false)

  tienda tienda? @relation(fields: [id_tienda], references: [id_tienda], onDelete: SetNull)
  stocks stock[]
}

model stock {
  id_producto Int
  id_almacen  Int
  cantidad    Decimal @db.Decimal(12, 2)

  producto producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)
  almacen  almacen  @relation(fields: [id_almacen], references: [id_almacen], onDelete: Cascade)

  @@id([id_producto, id_almacen])
}

model archivo {
  id_archivo  Int    @id @default(autoincrement())
  link        String @db.VarChar(500)
  tipo        String @db.VarChar(50)
  descripcion String @db.VarChar(255)

  productos archivo_producto[]
}

model archivo_producto {
  id_archivo  Int
  id_producto Int

  archivo  archivo  @relation(fields: [id_archivo], references: [id_archivo], onDelete: Cascade)
  producto producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@id([id_archivo, id_producto])
}

model categoria {
  id_categoria    Int     @id @default(autoincrement())
  nombre          String  @db.VarChar(255)
  slug            String  @unique @db.VarChar(255)
  nivel           Int
  id_cat_superior Int?
  odoo_id         Int?    @unique
  imagen          String? @db.VarChar(500)

  superior        categoria?                 @relation("CategoriaJerarquia", fields: [id_cat_superior], references: [id_categoria], onDelete: SetNull)
  subcategorias   categoria[]                @relation("CategoriaJerarquia")
  productos       categoria_producto[]
  caracteristicas caracteristica_categoria[]
  familias        familia[]
  promociones     promocion_categoria[]
  menu_items      menu_item[]                @relation("menu_item_categoria_rel")
  menu_hijos      menu_item_hijo[]           @relation("menu_item_hijo_categoria_rel")
}

model promocion {
  id_promocion    Int     @id @default(autoincrement())
  nombre          String  @db.VarChar(255)
  subtitulo       String? @db.VarChar(255)
  icono           String? @db.VarChar(500)
  etiqueta_imagen String? @db.VarChar(500)
  prioridad       Int     @default(0)
  slug            String  @unique @db.VarChar(255)
  activo          Boolean @default(true)
  /// Si true, la promo incluye productos con producto.cuotas_max = cuotas (sin lista manual).
  por_cuotas      Boolean @default(false)
  cuotas          Int?

  categorias promocion_categoria[]
  productos promocion_producto[]
}

model promocion_categoria {
  id_promocion Int
  id_categoria Int

  promocion promocion @relation(fields: [id_promocion], references: [id_promocion], onDelete: Cascade)
  categoria categoria @relation(fields: [id_categoria], references: [id_categoria], onDelete: Cascade)

  @@id([id_promocion, id_categoria])
}

model promocion_producto {
  id_promocion Int
  id_producto  Int

  promocion promocion @relation(fields: [id_promocion], references: [id_promocion], onDelete: Cascade)
  producto  producto  @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@id([id_promocion, id_producto])
}

/// Regla de regalo por monto mínimo de compra (ej. juguete desde $750.000)
model regalo {
  id_regalo           Int       @id @default(autoincrement())
  nombre              String    @db.VarChar(255)
  monto_minimo        Decimal   @db.Decimal(12, 2)
  vigencia_desde      DateTime
  vigencia_hasta      DateTime?
  activo              Boolean   @default(true)
  fecha_creacion      DateTime  @default(now())
  id_usuario_creacion Int
  fecha_modif         DateTime  @updatedAt

  usuario_creacion usuario           @relation("RegaloCreacion", fields: [id_usuario_creacion], references: [id_usuario])
  productos        regalo_producto[]

  @@index([activo, vigencia_desde])
}

model regalo_producto {
  id_regalo   Int
  id_producto Int

  regalo   regalo   @relation(fields: [id_regalo], references: [id_regalo], onDelete: Cascade)
  producto producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@id([id_regalo, id_producto])
}

model categoria_producto {
  id_categoria Int
  id_producto  Int

  categoria categoria @relation(fields: [id_categoria], references: [id_categoria], onDelete: Cascade)
  producto  producto  @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@id([id_categoria, id_producto])
}

model precio_producto {
  id_producto     Int
  fecha_desde     DateTime @db.Date
  precio          Decimal  @db.Decimal(12, 2)
  porcentaje_desc Decimal? @db.Decimal(5, 2)
  precio_con_desc Decimal? @db.Decimal(12, 2)

  producto producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@id([id_producto, fecha_desde])
}

model caracteristica {
  id_caracteristica Int    @id @default(autoincrement())
  nombre            String @db.VarChar(255)

  categorias caracteristica_categoria[]
  productos  producto_caracteristica[]
}

model caracteristica_categoria {
  id_caracteristica Int
  id_categoria      Int

  caracteristica caracteristica @relation(fields: [id_caracteristica], references: [id_caracteristica], onDelete: Cascade)
  categoria      categoria      @relation(fields: [id_categoria], references: [id_categoria], onDelete: Cascade)

  @@id([id_caracteristica, id_categoria])
}

model producto_caracteristica {
  id_producto       Int
  id_caracteristica Int
  valor_numerico    Boolean @default(false)
  valor             String  @db.VarChar(255)

  producto       producto       @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)
  caracteristica caracteristica @relation(fields: [id_caracteristica], references: [id_caracteristica], onDelete: Cascade)

  @@id([id_producto, id_caracteristica])
}

model usuario {
  id_usuario          Int      @id @default(autoincrement())
  mail                String   @unique @db.VarChar(255)
  tipo_usuario        String   @db.VarChar(20)
  fecha_hora_registro DateTime @default(now())
  activo              Boolean  @default(true)

  cliente            cliente?
  cupones_creados    cupones_descuento[] @relation("CuponCreacion")
  regalos_creados    regalo[]            @relation("RegaloCreacion")
}

model cliente {
  id_cliente             Int      @id @default(autoincrement())
  id_usuario             Int?     @unique
  id_direccion_principal Int?     @unique
  nombre                 String   @db.VarChar(100)
  apellido               String   @db.VarChar(100)
  mail                   String   @unique @db.VarChar(255)
  tipo_documento         String?  @db.VarChar(20)
  numero_documento       String?  @db.VarChar(50)
  telefono               String?  @db.VarChar(50)
  /// CF = Consumidor Final | RI = IVA responsable inscripto
  responsabilidad_impositiva String @default("CF") @db.VarChar(2)
  fecha_hora_registro    DateTime @default(now())
  odoo_partner_id        Int?     @unique

  usuario             usuario?      @relation(fields: [id_usuario], references: [id_usuario], onDelete: SetNull)
  direccion_principal direccion?    @relation("DireccionPrincipal", fields: [id_direccion_principal], references: [id_direccion], onDelete: SetNull)
  direcciones         direccion[]   @relation("ClienteDirecciones")
  ventas              venta[]
  lista_deseos        lista_deseos?
}

model direccion {
  id_direccion  Int      @id @default(autoincrement())
  id_cliente    Int
  calle         String   @db.VarChar(255)
  numero        String   @db.VarChar(20)
  piso          String?  @db.VarChar(20)
  departamento  String?  @db.VarChar(20)
  barrio        String?  @db.VarChar(100)
  localidad     String   @db.VarChar(100)
  provincia     String   @db.VarChar(100)
  pais          String   @default("Argentina") @db.VarChar(100)
  codigo_postal String?  @db.VarChar(20)
  latitud       Decimal? @db.Decimal(10, 7)
  longitud      Decimal? @db.Decimal(10, 7)
  referencias   String?  @db.VarChar(500)

  cliente                cliente  @relation("ClienteDirecciones", fields: [id_cliente], references: [id_cliente], onDelete: Cascade)
  cliente_como_principal cliente? @relation("DireccionPrincipal")
  envios                 envio[]
  ventas_facturacion     venta[]  @relation("VentaFacturacion")
}

model venta {
  id_venta     Int      @id @default(autoincrement())
  id_cliente   Int
  fecha_hora   DateTime @default(now())
  estado       String   @db.VarChar(30)
  tipo_entrega String   @db.VarChar(20)
  subtotal     Decimal  @db.Decimal(12, 2)
  descuento    Decimal  @default(0) @db.Decimal(12, 2)
  costo_envio  Decimal  @default(0) @db.Decimal(12, 2)
  total        Decimal  @db.Decimal(12, 2)
  /// Si retira/recibe otra persona
  receptor_nombre String? @db.VarChar(200)
  receptor_dni    String? @db.VarChar(50)
  id_direccion_facturacion Int?
  id_cupon                 Int? @unique
  idempotency_key          String?   @unique @db.VarChar(64)
  /// Token opaco para la URL de confirmación (anti-enumeración)
  access_token             String    @unique @db.VarChar(64)
  /// Tienda elegida cuando tipo_entrega = "retiro"
  id_tienda_retiro         Int?
  odoo_partner_id          Int?
  odoo_order_id            Int?      @unique
  odoo_order_name          String?   @db.VarChar(50)
  odoo_payment_id          Int?      @unique
  odoo_payment_name        String?   @db.VarChar(50)
  /// odoo_id del almacén desde el que se sirve el pedido (14 para envío)
  odoo_warehouse_id        Int?
  odoo_sync_estado         String    @default("pendiente") @db.VarChar(20)
  odoo_sync_error          String?   @db.Text
  odoo_sync_intentos       Int       @default(0)
  odoo_sync_at             DateTime?
  /// Seguimiento comercial: si el cliente ya fue contactado
  contactado               Boolean   @default(false)
  /// Nota / comentario interno del vendedor
  comentario               String?   @db.Text

  cliente  cliente         @relation(fields: [id_cliente], references: [id_cliente])
  detalles venta_detalle[]
  pagos    pago[]
  envios   envio[]
  direccion_facturacion direccion? @relation("VentaFacturacion", fields: [id_direccion_facturacion], references: [id_direccion], onDelete: SetNull)
  cupon    cupones_descuento? @relation(fields: [id_cupon], references: [id_cupon], onDelete: SetNull)
  tienda_retiro tienda? @relation(fields: [id_tienda_retiro], references: [id_tienda], onDelete: SetNull)
}

/// Cupones de descuento de monto fijo (emitidos desde admin)
model cupones_descuento {
  id_cupon            Int       @id @default(autoincrement())
  codigo              String    @unique @db.VarChar(60)
  monto               Decimal   @db.Decimal(12, 2)
  fecha_vigencia      DateTime
  /// emitido | consumido
  estado              String    @db.VarChar(20)
  grupo               String?   @db.VarChar(100)
  fecha_creacion      DateTime  @default(now())
  id_usuario_creacion Int
  fecha_consumido     DateTime?
  /// Venta que lo consumió (denormalizado; el FK formal está en venta.id_cupon)
  id_venta            Int?

  usuario_creacion usuario @relation("CuponCreacion", fields: [id_usuario_creacion], references: [id_usuario])
  venta            venta?

  @@index([grupo])
  @@index([estado])
  @@index([id_venta])
}

model venta_detalle {
  id_venta        Int
  item            Int
  id_producto     Int
  nombre_producto String  @db.VarChar(255)
  cantidad        Decimal @db.Decimal(12, 2)
  precio_unitario Decimal @db.Decimal(12, 2)
  subtotal        Decimal @db.Decimal(12, 2)
  /// Precio bruto efectivamente cobrado (con descuentos)
  precio_cobrado  Decimal? @db.Decimal(12, 2)

  venta    venta    @relation(fields: [id_venta], references: [id_venta], onDelete: Cascade)
  producto producto @relation(fields: [id_producto], references: [id_producto])

  @@id([id_venta, item])
}

model pago {
  id_pago        Int     @id @default(autoincrement())
  id_venta       Int
  tipo_pago      String  @db.VarChar(20)
  estado         String  @db.VarChar(30)
  monto          Decimal @db.Decimal(12, 2)
  referencia     String? @db.VarChar(255)
  transaction_id String? @unique @db.VarChar(255)

  venta venta @relation(fields: [id_venta], references: [id_venta], onDelete: Cascade)
}

model envio {
  id_envio     Int     @id @default(autoincrement())
  id_venta     Int
  tipo         String  @db.VarChar(30)
  estado       String  @db.VarChar(30)
  id_direccion Int
  tracking     String? @db.VarChar(255)

  venta     venta     @relation(fields: [id_venta], references: [id_venta], onDelete: Cascade)
  direccion direccion @relation(fields: [id_direccion], references: [id_direccion])
}

/// Parámetros genéricos de configuración (nombre / tipo / valor)
model parametro {
  id_parametro     Int      @id @default(autoincrement())
  nombre           String   @unique @db.VarChar(100)
  /// string | number | boolean | json
  tipo             String   @db.VarChar(30)
  valor            String   @db.Text
  /// Agrupación lógica (ej. envios)
  grupo_parametros String?  @db.VarChar(50)
  fecha_alta       DateTime @default(now())
  fecha_modif      DateTime @updatedAt

  @@index([grupo_parametros])
}

/// Códigos postales habilitados para entrega por proveedor logístico
model codigo_postal_envio {
  id_cp_envio   Int      @id @default(autoincrement())
  /// fastrack | smartpost
  proveedor     String   @db.VarChar(50)
  codigo_postal String   @db.VarChar(20)
  localidad     String   @db.VarChar(255)
  dias_entrega  Int
  precio        Decimal  @db.Decimal(12, 2)
  /// Zona tarifaria (FastTrack); null en SmartPost
  zona          Int?
  fecha_alta    DateTime @default(now())
  fecha_modif   DateTime @updatedAt

  @@unique([proveedor, codigo_postal])
  @@index([codigo_postal])
  @@index([proveedor])
  @@index([proveedor, zona])
}

/// Items principales del menú de navegación (Mac, iPhone, Promociones, etc.)
model menu_item {
  id_menu_item     Int      @id @default(autoincrement())
  label            String   @db.VarChar(100)
  href             String   @db.VarChar(255)
  /// FK opcional a categoría — cuando está seteado, href se computa desde la categoría
  id_categoria     Int?
  shop_label       String?  @db.VarChar(255)
  /// "dinamico" = se puede agregar/quitar; "fijo" = solo activar/desactivar
  tipo             String   @db.VarChar(20)
  /// "promociones" para carga dinámica de children desde promos activas
  dynamic_children String?  @db.VarChar(50)
  badge            String?  @db.VarChar(50)
  orden            Int
  activo           Boolean  @default(true)

  categoria categoria? @relation("menu_item_categoria_rel", fields: [id_categoria], references: [id_categoria], onDelete: SetNull)
  hijos     menu_item_hijo[]

  @@index([activo, orden])
  @@index([id_categoria])
}

/// Sub-items del dropdown de un menu_item
model menu_item_hijo {
  id_menu_hijo  Int      @id @default(autoincrement())
  id_menu_item  Int
  label         String   @db.VarChar(100)
  href          String   @db.VarChar(255)
  /// FK opcional a categoría — cuando está seteado, href se computa desde la categoría
  id_categoria  Int?
  badge         String?  @db.VarChar(50)
  icon          String?  @db.VarChar(255)
  variant       String   @default("product") @db.VarChar(20)
  orden         Int
  activo        Boolean  @default(true)

  parent    menu_item @relation(fields: [id_menu_item], references: [id_menu_item], onDelete: Cascade)
  categoria categoria? @relation("menu_item_hijo_categoria_rel", fields: [id_categoria], references: [id_categoria], onDelete: SetNull)

  @@index([id_menu_item, activo, orden])
  @@index([id_categoria])
}
