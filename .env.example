DATABASE_URL="mysql://root:root@localhost:3306/oneclickstore"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
# Debe coincidir con el dominio canónico (www O sin www, no ambos).
# En Google Cloud → redirect: {AUTH_URL}/api/auth/callback/google
# La app redirige el host alternativo (www↔apex) a este origen.
AUTH_URL="http://localhost:3000"
AUTH_DEV_BYPASS="true"
NEXT_PUBLIC_WHATSAPP_PHONE="5493415404538"
NEXT_PUBLIC_SITE_NAME="OneClick"
UPLOADS_DIR="uploads"
NEXT_PUBLIC_UPLOADS_BASE_URL="/api/uploads"
SEED_ADMIN_EMAIL="admin@oneclickstore.com"

# === Analytics / ads (opcionales; sin ellos no se cargan scripts) ===
# GA4 measurement ID
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# Google Ads conversion ID (solo el número, sin prefijo AW-)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Etiqueta de conversión de Google Ads (Purchase)
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
# Opcional: protege GET /api/feeds/google-merchant (?token=...). Sin valor, el feed es público.
# GOOGLE_MERCHANT_FEED_TOKEN=

# === Mercado Pago ===
# Usar credenciales de prueba durante el desarrollo. Nunca exponer este token al cliente.
MERCADOPAGO_ACCESS_TOKEN=
# Public key (misma aplicación) para el formulario de tarjeta embebido (Card Payment Brick).
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Secreto de firma de Webhooks (Tu integración → Webhooks → Firma secreta).
# Obligatorio en producción; sin él el endpoint /api/mercadopago/webhook responde 401.
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública HTTPS en producción (necesaria para back URLs y webhooks).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# === Odoo (oneclick.adhoc.ar) - JSON-RPC ===
# Credenciales de conexión (permanecen en env).
ODOO_URL=https://oneclick.adhoc.ar
ODOO_DB=odoo
ODOO_UID=21
ODOO_API_KEY=

# Secreto para endpoints de cron (POST /api/cron/sync-stock, /api/cron/sync-precios,
# /api/cron/avisos-stock).
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# === Seguimiento de envíos (ePresis) ===
# Tokens API del panel WP (Ajustes → Seguimiento Envíos) o solicitados a cada proveedor.
# FastTrack: soporte@fasttrack.com.ar | SmartPost: vía su plataforma.
FASTRACK_API_TOKEN=
SMARTPOST_API_TOKEN=
# Opcional: override de endpoints (defaults ePresis)
# FASTRACK_SEGUIMIENTO_URL=https://fasttracklv.epresis.com/api/v2/seguimiento.json
# SMARTPOST_SEGUIMIENTO_URL=https://smartpostecommerce.epresis.com/api/v2/seguimiento.json

# === SMTP (formularios de contacto / solicitudes) ===
# Mismo patrón que la intranet OneClick (p. ej. smtp.gmail.com).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# tls | ssl
SMTP_SECURE=tls
# Remitente (opcional; por defecto SMTP_USER)
SMTP_FROM=

# IDs de integración checkout (company, journals, etc.): tabla `parametro`, grupo `odoo`.
# Editar en Admin → Parámetros o vía seed (`npm run db:seed`).
