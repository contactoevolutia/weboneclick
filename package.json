{
  "name": "web-oneclick",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next dev --webpack",
    "dev:turbo": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "node scripts/start-server.mjs",
    "start:next": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "seed:odoo-params": "tsx scripts/seed-odoo-params.ts",
    "sync:odoo": "tsx scripts/sync-odoo.ts",
    "sync:stock": "tsx scripts/sync-stock.ts",
    "sync:precios": "tsx scripts/sync-precios.ts",
    "sync:precios-promo": "tsx scripts/sync-precios-promo.ts",
    "sync:ventas-productos": "tsx scripts/sync-ventas-productos.ts",
    "sync:gallery": "tsx scripts/sync-product-gallery.ts",
    "sync:home-images": "tsx scripts/sync-home-images.ts",
    "sync:ventas": "tsx scripts/sync-ventas-odoo.ts",
    "test:checkout-odoo": "tsx scripts/test-checkout-odoo.ts",
    "test:odoo-amount": "tsx scripts/test-odoo-amount.ts",
    "test:order-mail": "tsx scripts/test-order-mail.ts",
    "build:legacy-redirects": "tsx scripts/build-legacy-redirects.ts",
    "assets:download": "node scripts/download-assets.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@mercadopago/sdk-react": "^1.0.7",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.6.1",
    "leaflet": "^1.9.4",
    "mercadopago": "^3.2.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^9.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.61.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.18",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "browserslist": "4.28.7",
    "minimatch": "^10.2.6",
    "brace-expansion": "^5.0.8",
    "nodemailer": "^9.0.1",
    "deepmerge-ts": "^8.0.0"
  },
  "description": "Sitio web de **[OneClick](https://www.oneclickstore.com/)** (Apple Premium Reseller): catálogo público sincronizado con Odoo, carrito/checkout, páginas institucionales y panel de administración.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contactoevolutia/weboneclick.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/contactoevolutia/weboneclick/issues"
  },
  "homepage": "https://github.com/contactoevolutia/weboneclick#readme"
}
